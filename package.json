{
  "name": "sareoffice",
  "version": "0.1.0",
  "private": true,
  "description": "Panel de control de Saredigital donde un equipo de agentes de IA trabaja los issues de GitHub.",
  "keywords": [
    "claude-code",
    "codex",
    "opencode",
    "claude-agent-sdk",
    "ai-agents",
    "coding-agents",
    "github-issues",
    "automation",
    "dashboard"
  ],
  "homepage": "https://github.com/Saredigital/cubefarm#readme",
  "bugs": "https://github.com/Saredigital/cubefarm/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Saredigital/cubefarm.git"
  },
  "license": "MIT",
  "author": "Saredigital (basado en cubefarm de Leon van Zyl)",
  "type": "module",
  "bin": {
    "sareoffice": "bin/sareoffice.js"
  },
  "files": [
    "bin",
    "dist",
    "dist-server"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/office.mjs --dev",
    "demo": "node scripts/office.mjs --dev --demo",
    "build": "tsc --noEmit -p tsconfig.json && vite build && node scripts/build-server.mjs",
    "start": "node scripts/office.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretest:e2e": "node scripts/e2e-check.mjs",
    "test:e2e": "playwright test",
    "login": "node bin/sareoffice.js login",
    "doctor": "node bin/sareoffice.js doctor",
    "company:broker": "tsx server/company-security/broker.ts",
    "company:provision": "tsx scripts/company-broker-provision.ts",
    "company:setup-local": "tsx server/company-security/setupLocal.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.283",
    "@lydell/node-pty": "1.2.0-beta.15",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@playwright/mcp": "0.0.83",
    "@upstash/box": "^0.7.9",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/headless": "^6.0.0",
    "express": "^5.2.1",
    "imapflow": "^2.5.9",
    "mailparser": "^3.10.0",
    "nodemailer": "^10.1.7",
    "ws": "^8.22.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/express": "^5.0.6",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^26.6.3",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "concurrently": "^10.0.5",
    "esbuild": "^0.28.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "zustand": "^5.0.15"
  }
}
